# OpenAI (main.js, mainWithoutVectordb.js, code-from-guruji/, from-go/)
OPENAI_API_KEY=
# Optional: overrides the chat model used by main.js (default gpt-5.6-luna)
OPENAI_CHAT_MODEL=

# Pinecone (main.js, code-from-guruji/, using-langchain/, from-go/)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
# Required by using-langchain/ and from-go/; code-from-guruji/ defaults to "shop-support"
PINECONE_INDEX_NAME=
# Optional: code-from-guruji/ defaults to "policies"; from-go/ uses the default namespace when empty
PINECONE_NAMESPACE=

# Gemini (using-langchain/)
GEMINI_API_KEY=

# Optional fallback key used by code-from-guruji/ when OPENAI_API_KEY / PINECONE_API_KEY are unset
OWN_KEY=
